package main

import (
	"fmt"
)

func swap(a, b *int) {
	*a, *b = *b, *a
}

func main() {
	var num1, num2 int
	fmt.Print("Enter two numbers: ")
	fmt.Scan(&num1, &num2)

	fmt.Println("Before swapping:")
	fmt.Println("Num1:", num1, "Num2:", num2)

	swap(&num1, &num2)

	fmt.Println("After swapping:")
	fmt.Println("Num1:", num1, "Num2:", num2)
}
