package main

import (
    "fmt"
)

func main() {
    // Create a channel to communicate integers
    ch := make(chan int)

    // Start a goroutine to send data into the channel
    go func() {
        for i := 1; i <= 5; i++ {
            ch <- i // Send data to the channel
        }
        close(ch) // Close the channel after sending all the data
    }()

    // Receive data from the channel using for range loop
    fmt.Println("Received data from the channel:")
    for val := range ch {
        fmt.Println(val)
    }

    fmt.Println("Channel is closed, no more data!")
}


