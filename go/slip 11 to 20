)

// Function to print the multiplication table of a given number
func multiplicationTable(num int) {
	fmt.Println("Multiplication Table of", num)
	for i := 1; i <= 10; i++ {
		fmt.Printf("%d x %d = %d\n", num, i, num*i)
	}
}

