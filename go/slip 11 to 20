package main

import (
	"fmt"
)

func main() {
	// Creating and initializing a slice
	numbers := []int{1, 2, 3, 4, 5}
	fmt.Println("Initial Slice:", numbers)

	// Appending elements to the slice
	numbers = append(numbers, 6, 7, 8)
	fmt.Println("After Appending:", numbers)

	// Removing an element from the slice (e.g., removing index 2)
	indexToRemove := 2
	numbers = append(numbers[:indexToRemove], numbers[indexToRemove+1:]...)
	fmt.Println("After Removing Index 2:", numbers)

	// Copying a slice
	copySlice := make([]int, len(numbers))
	copy(copySlice, numbers)
	fmt.Println("Copied Slice:", copySlice)
}
