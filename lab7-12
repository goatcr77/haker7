plt.figure(figsize=(12,6)) 
plt.plot(df, label='Power Demand') 
plt.xlabel('Timestamp') 
plt.ylabel('Demand (MW)') 
plt.title('Electrical Power Demand Over Time') 
plt.legend() 
plt.show() 
